# API keys for the news and macro layer.
#
# Copy to .env and fill in the values you have. Every key is optional: the
# pipeline runs offline against fixtures, and a command that needs a key it does
# not have fails with one clear line naming the variable.
#
# Keys are read from the environment, never from command-line arguments, so they
# stay out of shell history and out of any process listing.

# Massive (formerly Polygon). News provider for `argos news fetch`.
# The Stocks Basic plan allows about 5 requests/minute and roughly two years of
# news history, so a 2020-2025 pull will not return 2020. `argos news audit
# --expected-start` is how you notice that rather than discovering it in a
# backtest.
MASSIVE_API_KEY=

# OpenAI. Only needed for `argos news analyze --analyzer openai`.
# The model id is never defaulted: pass --model explicitly so every event's
# recorded provenance names a model you actually intended to use.
OPENAI_API_KEY=

# FRED / ALFRED. Macro observations, including ALFRED vintage dates.
FRED_API_KEY=

# EDGAR needs no key. It does require a descriptive User-Agent naming you, and
# SEC fair-access guidance asks for no more than 10 requests/second.
EDGAR_USER_AGENT=