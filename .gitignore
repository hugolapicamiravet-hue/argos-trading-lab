# --- virtual environments ---------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- python build / cache artifacts ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- tooling caches --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
.tox/

# --- downloaded market data (never versioned) ------------------------------
# Reproducible from `scripts/run_backtest.py` without `--offline`.
# Cached CSVs are provider output, not source.
data/raw/*
!data/raw/.gitkeep

# --- experiment exports (regenerate with --export-csv) --------------------
data/exports/*
!data/exports/.gitkeep

# --- news datasets (licensed provider output, regenerate from `news fetch`) --
# Raw captures, normalized articles, inferred events and manifests all stay out
# of version control. The code that produces them is the artifact worth
# reviewing; a corpus of redistributable news is not.
data/news/*
!data/news/.gitkeep
# The offline fixtures used by tests are small, synthetic and self-authored, so
# they are safe to track. Keep that narrow on purpose.
!data/news/fixtures/
!data/news/fixtures/**

# --- secrets and local environment -----------------------------------------
# API keys are read from the environment by the news and macro layer. A real
# .env file must never reach a commit; the example listing variable names is the
# one file here that is safe to track.
.env
.env.*
!.env.example
*.env
secrets.json
secrets.yaml
secrets.yml
*.pem
*.key
*.p12
credentials.json
service-account*.json
.cookies.json
.yfinance/

# --- local noise and logs --------------------------------------------------
*.log
*.out
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
